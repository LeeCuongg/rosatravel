# MongoDB Atlas — nhớ có tên database sau dấu "/" (vd. /rosatravel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/rosatravel?retryWrites=true&w=majority
PAYLOAD_SECRET=

# Vercel Blob — lưu ảnh upload trong admin
BLOB_READ_WRITE_TOKEN=

# Local: http://localhost:3000 · Production: https://rosatravel.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gửi email báo nhân viên khi có yêu cầu đặt tour (https://resend.com → API Keys).
# Để trống: yêu cầu vẫn lưu vào admin, chỉ không gửi email.
RESEND_API_KEY=
# Địa chỉ gửi. Chưa xác minh tên miền trên Resend thì chỉ dùng được onboarding@resend.dev
# và chỉ gửi tới email của chính tài khoản Resend.
RESEND_FROM=Rosa Travel <onboarding@resend.dev>
